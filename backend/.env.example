# Copy to .env and adjust as needed. .env is gitignored.

# Postgres DSN. Matches the docker-compose.yml service; the app falls back to
# this exact value when DATABASE_URL is unset, so local dev needs no .env at all.
DATABASE_URL=postgresql://postgres@localhost:5433/interconnection

# Anthropic API key. Leave blank here; put the real key only in your own .env.
ANTHROPIC_API_KEY=

# Spending limits for one assessment. Unset means the default shown.
# AGENT_MAX_TURNS=10
# AGENT_MAX_TOKENS_PER_ASSESSMENT=200000
# AGENT_MAX_OUTPUT_TOKENS_PER_CALL=16000
